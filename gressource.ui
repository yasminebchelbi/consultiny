      <property name="styleSheet">
       <string notr="true">QPushButton {
    font-family: Arial, sans-serif;  /* Police élégante */
    font-size: 12px;                 /* Taille du texte */
    font-weight: bold;               /* Texte en gras */
    color: #4B4B4B;                  /* Couleur du texte */
    background-color: #E8E3DD;       /* Fond doux */
    padding: 8px 9px;              /* Espacement interne */
    border-radius: 5px;              /* Coins arrondis */
    text-align: center;              /* Centrer le texte */
    margin: 8px;                    /* Espacement externe */
    border: 2px solid #D1C8B9;       /* Bordure douce */
}

QPushButton:hover {
    background-color: #D1C8B9;       /* Fond plus foncé au survol */
    border: 2px solid #A89F92;       /* Bordure changeante */
}

QPushButton:disabled {
    color: #A0A0A0;                  /* Couleur du texte désactivé */
    background-color: #F0F0F0;       /* Fond plus clair quand désactivé */
    border: 2px solid #A0A0A0;       /* Bordure désactivée */
}</string>
