    <property name="styleSheet">
     <string notr="true">/* Style du QTabWidget */
QTabWidget::pane {
    border: 1px solid ;
    background-color:#dcdcda
   
}

/* Style des onglets */
QTabBar::tab {
    background: #6F7DAB;
    color: #E8E3DD;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 15px;
    font-family: &quot;Poppins&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 14px;
}

/* Onglet sélectionné */
QTabBar::tab:selected {
    background:  #DCDCDA;
    color: #263A69;
    font-weight: bold;
}</string>
