    padding: 10px 15px;
    font-size: 14px;
    color: white;
    font-weight: bold;
    text-transform: uppercase;
    transition: 0.3s;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #388E3C, stop:1 #4CAF50); /* Inversion du dégradé */
    border: 2px solid #4CAF50;
}

QPushButton:pressed {
    background-color: #2E7D32; /* Couleur plus foncée au clic */
    border: 2px solid #2E7D32;
}
QIcon{
color: white;
