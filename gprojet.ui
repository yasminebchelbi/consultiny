      <property name="styleSheet">
       <string notr="true">QComboBox {
    background-color: #E8E3DD; /* Couleur de fond clair */
    border: 2px solid #D1C8B9; /* Bordure subtile */
    border-radius: 10px; /* Coins arrondis */
    padding: 5px 15px; /* Espacement interne */
    font-size: 14px; /* Taille de texte */
    color: #4B4B4B; /* Couleur du texte */
    font-weight: bold;
}

QComboBox:hover {
    border: 2px solid #D1C8B9; /* Changement de couleur au survol */
}

QComboBox:focus {
    border: 2px solid #A89F92; /* Bordure plus foncée au focus */
}

QComboBox QAbstractItemView {
    background-color: #FFF; /* Couleur de fond du menu déroulant */
    border: 2px solid #D1C8B9;
    border-radius: 10px;
    selection-background-color: #D1C8B9; /* Couleur de sélection des éléments */
    selection-color: #4B4B4B; /* Couleur du texte sélectionné */
}

QComboBox::down-arrow {
    image: url(:/images/arrow.png); /* Icône de flèche personnalisée */
    width: 20px;
    height: 20px;
}
</string>
