      <property name="styleSheet">
       <string notr="true">QLineEdit {
    background-color: #f5f5f5; /* Fond clair et épuré */
    border: 2px solid #6f7dab; /* Bordure bleu-gris */
    border-radius: 15px; /* Coins arrondis */
    padding: 8px 15px;
    font-size: 14px;
    color: #333; /* Couleur du texte */
    selection-background-color: #6f7dab; /* Couleur de sélection */
}

QLineEdit:focus {
    border: 2px solid #6f7dab; /* Changement de bordure au focus */
    background-color: white; /* Fond plus visible */
}

QLineEdit::placeholder {
    color: #999; /* Couleur du placeholder */
    font-style: italic;
}
