      <property name="styleSheet">
       <string notr="true">QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #6f7dab, stop:1 #5b6d96); /* Dégradé bleu-gris */
    border: 2px solid #5b6d96;
    border-radius: 15px; /* Coins arrondis */
    padding: 10px 15px;
    font-size: 14px;
    color: white;
    font-weight: bold;
    text-transform: uppercase;
    transition: 0.3s;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #5b6d96, stop:1 #6f7dab); /* Inversion du dégradé */
    border: 2px solid #6f7dab;
}

QPushButton:pressed {
    background-color: #4a5a82; /* Couleur plus foncée au clic */
    border: 2px solid #4a5a82;
}
QPushButton:icon {
    color: #4B4B4B; /* Couleur de l'icône */
}

QPushButton:disabled {
    background-color: #D1C8B9; /* Fond pour état désactivé */
    color: #A0A0A0; /* Couleur de texte pour désactivation */
    border: 2px solid #A0A0A0; /* Bordure pour désactivation */
}

QPushButton:hover::icon {
    color: #FFFFFF; /* Changement de couleur de l'icône au survol */
}</string>
