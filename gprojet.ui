     <widget class="QTableView" name="tableView">
      <property name="geometry">
       <rect>
        <x>340</x>
        <y>70</y>
        <width>661</width>
        <height>191</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">/* Style global du tableau QTableView */
QTableView {  
    background-color: #EDECEA; /* Fond doux du tableau */
    border: 2px solid #838DB1; /* Bordure subtile mais visible */
    border-radius: 10px; /* Coins arrondis */
    gridline-color: #2B0101; /* Lignes de grille en couleur sombre */
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif; /* Police moderne et professionnelle */
    font-size: 14px; /* Taille de police standard */
    selection-background-color: #838DB1; /* Couleur de fond lors de la sélection */
    selection-color: white; /* Texte en blanc lors de la sélection */
    alternate-background-color: #F5F5F5; /* Fond alternatif pour les lignes paires (lignes de table) */
}

/* Style des sections de l'en-tête */
QHeaderView::section {
    background-color: #263A69; /* Fond sombre pour les en-têtes */
    color: white; /* Texte blanc pour les en-têtes */
    padding: 8px; /* Un peu d'espace autour du texte */
    border: none; /* Suppression des bordures internes */
    font-weight: bold; /* Texte en gras pour un meilleur contraste */
    border-radius: 5px; /* Coins arrondis pour les en-têtes */
    text-align: center; /* Centrage du texte */
}

/* Style des éléments dans le tableau (cellules) */
QTableView::item {
    padding: 6px; /* Espacement interne dans les cellules */
    border-bottom: 1px solid #E8E3DD; /* Légère séparation entre les lignes */
    color: black; /* Texte noir dans les cellules */
    background-color: transparent; /* Fond transparent pour une meilleure lisibilité */
}

/* Style des éléments sélectionnés dans le tableau */
QTableView::item:selected {
    background-color: #838DB1; /* Fond de sélection pour les éléments */
    color: white; /* Texte en blanc lorsqu'une cellule est sélectionnée */
}

/* Effet de survol pour les éléments du tableau */
QTableView::item:hover {
    background-color: #D0D8E4; /* Fond plus clair lors du survol */
    cursor: pointer; /* Curseur pointeur lors du survol */
}

/* Style pour les lignes alternées du tableau */
QTableView::item:alternate {
    background-color: #F7F7F7; /* Fond plus clair pour les lignes impaires */
}

/* Focus sur les en-têtes au survol */
QHeaderView::section:hover {
    background-color: #1C2D4B; /* Sombre mais plus visible au survol */
    cursor: pointer; /* Curseur pointeur sur l'en-tête */
}
</string>
      </property>
