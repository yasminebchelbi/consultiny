       <string notr="true">QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #E53935, stop:1 #B71C1C); /* Dégradé de rouge */
    border: 2px solid #B71C1C;
    border-radius: 15px; /* Coins arrondis */
    padding: 10px 15px;
    font-size: 14px;
    color: white;
    font-weight: bold;
    text-transform: uppercase;
    transition: 0.3s;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                stop:0 #B71C1C, stop:1 #E53935); /* Inversion du dégradé */
    border: 2px solid #E53935;
}

QPushButton:pressed {
    background-color: #C62828; /* Couleur plus foncée au clic */
    border: 2px solid #C62828;
}
</string>
