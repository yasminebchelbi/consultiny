    border-top-right-radius: 8px;
    padding: 8px 15px;
    font-family: &quot;Poppins&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 14px;
}

/* Onglet sélectionné */
QTabBar::tab:selected {
    background:  #DCDCDA;
    color: #263A69;
    font-weight: bold;
}

