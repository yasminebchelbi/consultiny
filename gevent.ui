      <property name="styleSheet">
       <string notr="true">/* 🔹 Style général du QCalendarWidget */
QCalendarWidget {
    font-family: &quot;Poppins&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 14px;
    background-color: #F5F5F5;
    border-radius: 10px;
    border: 5px solid #838db1;
}

/* 🔹 Barre de navigation (mois + année) */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #E8E3DD;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

/* 🔹 Boutons du mois et de l'année */
QCalendarWidget QToolButton {
    background-color: #E8E3DD;
    color: #263A69;
    border-radius: 5px;
    padding: 5px;
    font-weight: bold;
}
QCalendarWidget QToolButton:hover {
    background-color: #838db1;
    color: #EDECEA;
}

/* 🔹 Ligne des jours (lun., mar., mer., ...) */
QCalendarWidget QTableView QHeaderView::section {
    background-color: #6F7DAB;  /* Bleu élégant */
    color: #EDECEA;  /* Texte clair */
    font-weight: bold;
    padding: 6px;
    border: 1px solid #838db1;
}

/* 🔹 Colonne des semaines */
QCalendarWidget QTableView {
    alternate-background-color: #D6D3D1; /* Fond gris clair */
    color: #263A69; /* Texte foncé */
    border-right: 1px solid #838db1;
}

/* 🔹 Jours du calendrier */
QCalendarWidget QAbstractItemView {
    background-color: #F5F5F5;
    color: #263A69;
    selection-background-color: #838db1;
    selection-color: #EDECEA;
}

/* 🔹 Jour actuel sélectionné */
QCalendarWidget QAbstractItemView::item:selected {
    background-color: #5A6A99;
    color: #EDECEA;
    border-radius: 4px;
}

/* 🔹 Week-end (samedi et dimanche) */
QCalendarWidget QAbstractItemView::item:enabled:nth-child(6), 
QCalendarWidget QAbstractItemView::item:enabled:nth-child(7) {
    color: #B33F62;
}
</string>
      </property>
     </widget>
