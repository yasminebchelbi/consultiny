}

/* Style pour les QLabel */
QLabel {
    font: 12pt &quot;The Year of The Camel&quot;;
    color: #EDECEA; /* Texte clair pour contraste */
    font-weight: bold; /* Texte en gras */
    border: none; /* Pas de contour */
    background: none; /* Pas de fond */
}
QLineEdit {
    font-family: &quot;Poppins&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 14px;
    background-color: #E8E3DD;
    border: 1px solid #838db1;
    border-radius: 5px;
    padding: 4px;
    color: #263A69;
}
